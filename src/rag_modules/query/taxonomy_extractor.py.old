"""
Taxonomy Extractor - Automatic Domain Knowledge Discovery

This module extracts terminology, relationships, and domain knowledge from documents
to build a dynamic taxonomy for query enhancement. NO hardcoded domain logic.

Key Features:
- Pattern-based extraction (acronyms, definitions, enumerations)
- LLM-based relationship discovery
- Frequency analysis for term importance
- Hierarchical relationship mapping
- Cross-document term aggregation
"""

import re
import json
from typing import List, Dict, Set, Tuple, Optional
from collections import defaultdict, Counter
import structlog
from pathlib import Path

logger = structlog.get_logger()


class TaxonomyExtractor:
    """
    Extracts domain terminology and relationships from documents.

    Extraction Methods:
    1. Acronym Detection: "Net Premium Reserve (NPR)" → NPR is acronym for Net Premium Reserve
    2. Definition Detection: "X is defined as..." → X is a defined term
    3. Enumeration Detection: "types include: (a) X, (b) Y" → X and Y are siblings
    4. Synonym Detection: "X, also known as Y" → X and Y are synonyms
    5. Hierarchical Detection: "X includes Y and Z" → Y and Z are children of X
    6. LLM Relationship Extraction: Ask LLM to identify term relationships
    """

    def __init__(self, llm_client=None, min_term_frequency: int = 2):
        """
        Initialize taxonomy extractor.

        Args:
            llm_client: Optional LLM client for relationship extraction
            min_term_frequency: Minimum frequency for a term to be included
        """
        self.llm_client = llm_client
        self.min_term_frequency = min_term_frequency

        # Taxonomy storage
        self.terms = {}  # term → metadata
        self.relationships = defaultdict(list)  # term → [related terms]
        self.acronyms = {}  # acronym → full term
        self.synonyms = defaultdict(set)  # term → {synonyms}
        self.hierarchies = defaultdict(list)  # parent → [children]

        # Term frequency tracking
        self.term_counts = Counter()

        # Patterns for extraction
        self._compile_patterns()

    def _compile_patterns(self):
        """Compile regex patterns for term extraction."""

        # Acronym pattern: "Full Term (ACRONYM)"
        self.acronym_pattern = re.compile(
            r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s*\(([A-Z]{2,})\)',
            re.MULTILINE
        )

        # Definition patterns
        self.definition_patterns = [
            re.compile(r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+is\s+defined\s+as', re.IGNORECASE),
            re.compile(r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+means', re.IGNORECASE),
            re.compile(r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+refers\s+to', re.IGNORECASE),
            re.compile(r'the\s+term\s+"([^"]+)"', re.IGNORECASE),
        ]

        # Enumeration patterns: "(a) X (b) Y" or "1. X 2. Y" or "i. X ii. Y"
        self.enumeration_patterns = [
            re.compile(r'\(([a-z])\)\s*([A-Z][^\(]{5,50}?)(?=\([a-z]\)|\n|$)'),
            re.compile(r'(\d+)\.\s*([A-Z][^\d]{5,50}?)(?=\d+\.|\n|$)'),
            re.compile(r'\(([ivx]+)\)\s*([A-Z][^\(]{5,50}?)(?=\([ivx]+\)|\n|$)'),
        ]

        # Synonym patterns
        self.synonym_patterns = [
            re.compile(r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*),?\s+(?:also\s+)?known\s+as\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)', re.IGNORECASE),
            re.compile(r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+\((?:also\s+)?(?:called|termed)\s+([^\)]+)\)', re.IGNORECASE),
        ]

        # Hierarchical patterns: "X includes Y and Z"
        self.hierarchical_patterns = [
            re.compile(r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+(?:includes?|comprises?|consists?\s+of)\s+([^\.]{10,100})'),
            re.compile(r'types?\s+of\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+(?:include|are)\s*:?\s*([^\.]{10,200})'),
        ]

    def extract_from_text(self, text: str, source: str = "unknown") -> Dict:
        """
        Extract terminology from a single text.

        Args:
            text: Document text
            source: Source document identifier

        Returns:
            Dict with extracted terms and relationships
        """
        extracted = {
            'acronyms': [],
            'definitions': [],
            'enumerations': [],
            'synonyms': [],
            'hierarchies': [],
            'source': source
        }

        # 1. Extract acronyms
        acronyms = self._extract_acronyms(text)
        extracted['acronyms'] = acronyms
        for acronym, full_term in acronyms:
            self.acronyms[acronym] = full_term
            self.synonyms[full_term.lower()].add(acronym)
            self.synonyms[acronym].add(full_term.lower())

        # 2. Extract definitions
        definitions = self._extract_definitions(text)
        extracted['definitions'] = definitions
        for term in definitions:
            self.term_counts[term.lower()] += 1

        # 3. Extract enumerations (sibling relationships)
        enumerations = self._extract_enumerations(text)
        extracted['enumerations'] = enumerations
        for parent, children in enumerations:
            for child in children:
                self.hierarchies[parent.lower()].append(child.lower())
                self.relationships[parent.lower()].append(child.lower())
                self.term_counts[child.lower()] += 1

        # 4. Extract synonyms
        synonyms = self._extract_synonyms(text)
        extracted['synonyms'] = synonyms
        for term1, term2 in synonyms:
            self.synonyms[term1.lower()].add(term2.lower())
            self.synonyms[term2.lower()].add(term1.lower())

        # 5. Extract hierarchies
        hierarchies = self._extract_hierarchies(text)
        extracted['hierarchies'] = hierarchies
        for parent, children in hierarchies:
            for child in children:
                self.hierarchies[parent.lower()].append(child.lower())
                self.relationships[parent.lower()].append(child.lower())

        return extracted

    def _extract_acronyms(self, text: str) -> List[Tuple[str, str]]:
        """Extract acronyms with their full forms."""
        acronyms = []
        for match in self.acronym_pattern.finditer(text):
            full_term = match.group(1).strip()
            acronym = match.group(2).strip()
            acronyms.append((acronym, full_term))
        return acronyms

    def _extract_definitions(self, text: str) -> List[str]:
        """Extract defined terms."""
        definitions = []
        for pattern in self.definition_patterns:
            for match in pattern.finditer(text):
                term = match.group(1).strip()
                if len(term) > 3 and len(term) < 100:  # Filter noise
                    definitions.append(term)
        return definitions

    def _extract_enumerations(self, text: str) -> List[Tuple[str, List[str]]]:
        """
        Extract enumerated lists (sibling terms).
        Example: "Reserve types: (a) NPR (b) SR (c) DR"
        Returns: [("Reserve types", ["NPR", "SR", "DR"])]
        """
        enumerations = []

        for pattern in self.enumeration_patterns:
            # Find enumeration items
            matches = list(pattern.finditer(text))

            if len(matches) >= 2:  # Need at least 2 items to be a list
                items = []
                for match in matches:
                    item = match.group(2).strip()
                    # Clean up item
                    item = re.sub(r'\s+', ' ', item)
                    item = item.rstrip('.,;:')
                    if len(item) > 3 and len(item) < 100:
                        items.append(item)

                if items:
                    # Try to find parent term (look backward for "types of X", "X include", etc.)
                    start_pos = matches[0].start()
                    context = text[max(0, start_pos-200):start_pos]
                    parent = self._find_parent_term(context)

                    if parent:
                        enumerations.append((parent, items))
                    else:
                        # Generic parent
                        enumerations.append(("enumerated_items", items))

        return enumerations

    def _find_parent_term(self, context: str) -> Optional[str]:
        """Find parent term from context (text before enumeration)."""
        # Look for patterns like "types of X", "X include:", etc.
        parent_patterns = [
            re.compile(r'types?\s+of\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)', re.IGNORECASE),
            re.compile(r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\s+(?:include|comprises?|consists?\s+of)', re.IGNORECASE),
            re.compile(r'following\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)', re.IGNORECASE),
        ]

        for pattern in parent_patterns:
            match = pattern.search(context)
            if match:
                return match.group(1).strip()

        return None

    def _extract_synonyms(self, text: str) -> List[Tuple[str, str]]:
        """Extract synonym relationships."""
        synonyms = []
        for pattern in self.synonym_patterns:
            for match in pattern.finditer(text):
                term1 = match.group(1).strip()
                term2 = match.group(2).strip()
                if term1 and term2:
                    synonyms.append((term1, term2))
        return synonyms

    def _extract_hierarchies(self, text: str) -> List[Tuple[str, List[str]]]:
        """Extract hierarchical relationships (parent-child)."""
        hierarchies = []
        for pattern in self.hierarchical_patterns:
            for match in pattern.finditer(text):
                parent = match.group(1).strip()
                children_text = match.group(2).strip()

                # Split children by "and", "or", commas
                children = re.split(r'\s+and\s+|\s+or\s+|,\s*', children_text)
                children = [c.strip().rstrip('.,;:') for c in children if len(c.strip()) > 3]

                if children:
                    hierarchies.append((parent, children))

        return hierarchies

    async def extract_with_llm(self, text: str, chunk_size: int = 2000) -> Dict:
        """
        Use LLM to extract term relationships (more comprehensive than patterns).

        Args:
            text: Document text
            chunk_size: Size of text chunks to process

        Returns:
            Dict with LLM-extracted relationships
        """
        if not self.llm_client:
            logger.warning("LLM client not available for taxonomy extraction")
            return {}

        # Split text into chunks
        chunks = [text[i:i+chunk_size] for i in range(0, len(text), chunk_size)]

        all_relationships = defaultdict(list)

        for chunk in chunks[:5]:  # Limit to first 5 chunks for performance
            try:
                prompt = f"""Analyze this text and extract domain terminology relationships.

Text:
{chunk}

For each important concept, identify:
1. Related terms, synonyms, or acronyms
2. Types, variants, or subcategories
3. Parent-child relationships

Return JSON format:
{{
  "concept_name": {{
    "synonyms": ["synonym1", "synonym2"],
    "types": ["type1", "type2"],
    "related": ["related1", "related2"]
  }}
}}

Focus on technical terms, methodologies, and domain-specific concepts.
Only include relationships explicitly mentioned in the text.
"""

                response = await self.llm_client.chat.completions.create(
                    model="gpt-4o-mini",
                    messages=[{"role": "user", "content": prompt}],
                    temperature=0.3,
                    response_format={"type": "json_object"}
                )

                result = json.loads(response.choices[0].message.content)

                # Merge results
                for concept, relationships in result.items():
                    concept_lower = concept.lower()

                    # Add synonyms
                    if 'synonyms' in relationships:
                        for syn in relationships['synonyms']:
                            self.synonyms[concept_lower].add(syn.lower())
                            self.synonyms[syn.lower()].add(concept_lower)

                    # Add types (hierarchical)
                    if 'types' in relationships:
                        for typ in relationships['types']:
                            self.hierarchies[concept_lower].append(typ.lower())
                            self.relationships[concept_lower].append(typ.lower())
                            all_relationships[concept_lower].append(typ.lower())

                    # Add related terms
                    if 'related' in relationships:
                        for rel in relationships['related']:
                            self.relationships[concept_lower].append(rel.lower())
                            all_relationships[concept_lower].append(rel.lower())

            except Exception as e:
                logger.warning(f"LLM extraction failed for chunk: {e}")
                continue

        return dict(all_relationships)

    def build_taxonomy(self, documents: List[Dict]) -> Dict:
        """
        Build complete taxonomy from multiple documents.

        Args:
            documents: List of document dicts with 'content' and 'metadata'

        Returns:
            Complete taxonomy dict
        """
        logger.info(f"🔍 Building taxonomy from {len(documents)} documents")

        extraction_results = []

        for doc in documents:
            content = doc.get('content', '')
            source = doc.get('metadata', {}).get('filename', 'unknown')

            if not content or len(content) < 50:
                continue

            # Extract with patterns
            result = self.extract_from_text(content, source)
            extraction_results.append(result)

        # Filter by frequency
        filtered_terms = {
            term: count
            for term, count in self.term_counts.items()
            if count >= self.min_term_frequency
        }

        logger.info(
            f"✅ Taxonomy built: "
            f"{len(self.acronyms)} acronyms, "
            f"{len(filtered_terms)} terms, "
            f"{len(self.synonyms)} synonym groups, "
            f"{len(self.hierarchies)} hierarchies"
        )

        return {
            'acronyms': dict(self.acronyms),
            'terms': filtered_terms,
            'synonyms': {k: list(v) for k, v in self.synonyms.items()},
            'hierarchies': {k: list(set(v)) for k, v in self.hierarchies.items()},
            'relationships': {k: list(set(v)) for k, v in self.relationships.items()}
        }

    def get_related_terms(self, term: str, max_depth: int = 1) -> List[str]:
        """
        Get all related terms for query expansion.

        Args:
            term: Query term
            max_depth: How many levels deep to traverse relationships

        Returns:
            List of related terms
        """
        term_lower = term.lower()
        related = set()

        # Add acronym/full form
        if term_lower in self.acronyms:
            related.add(self.acronyms[term_lower])

        # Add synonyms
        if term_lower in self.synonyms:
            related.update(self.synonyms[term_lower])

        # Add child terms (types, variants)
        if term_lower in self.hierarchies:
            children = self.hierarchies[term_lower]
            related.update(children)

            # If max_depth > 1, recursively get children's children
            if max_depth > 1:
                for child in children:
                    grandchildren = self.get_related_terms(child, max_depth=max_depth-1)
                    related.update(grandchildren)

        # Add general relationships
        if term_lower in self.relationships:
            related.update(self.relationships[term_lower])

        return list(related)

    def save_taxonomy(self, filepath: str):
        """Save taxonomy to JSON file."""
        taxonomy = {
            'acronyms': self.acronyms,
            'synonyms': {k: list(v) for k, v in self.synonyms.items()},
            'hierarchies': {k: v for k, v in self.hierarchies.items()},
            'relationships': {k: v for k, v in self.relationships.items()},
            'term_counts': dict(self.term_counts)
        }

        Path(filepath).parent.mkdir(parents=True, exist_ok=True)
        with open(filepath, 'w') as f:
            json.dump(taxonomy, f, indent=2)

        logger.info(f"💾 Taxonomy saved to {filepath}")

    def load_taxonomy(self, filepath: str):
        """Load taxonomy from JSON file."""
        try:
            with open(filepath, 'r') as f:
                taxonomy = json.load(f)

            self.acronyms = taxonomy.get('acronyms', {})
            self.synonyms = defaultdict(set, {
                k: set(v) for k, v in taxonomy.get('synonyms', {}).items()
            })
            self.hierarchies = defaultdict(list, taxonomy.get('hierarchies', {}))
            self.relationships = defaultdict(list, taxonomy.get('relationships', {}))
            self.term_counts = Counter(taxonomy.get('term_counts', {}))

            logger.info(f"📂 Taxonomy loaded from {filepath}")
            return True
        except Exception as e:
            logger.warning(f"Failed to load taxonomy: {e}")
            return False