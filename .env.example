# AAIRE Environment Configuration
# Copy this file to .env and update with your actual values

# --- Required ---

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # Override default model (optional)

# Vector Database Configuration - Qdrant Cloud
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Authentication (no hardcoded fallbacks — these are required)
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Admin user credentials
AAIRE_ADMIN_EMAIL=admin@example.com
AAIRE_ADMIN_PASSWORD=change-me-in-production
AAIRE_ADMIN_NAME=Admin User

# --- Optional ---

# Regular user credentials
# AAIRE_USER_EMAIL=user@example.com
# AAIRE_USER_PASSWORD=change-me-in-production
# AAIRE_USER_NAME=Regular User

# Redis Configuration (for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# External APIs
# SEC_EDGAR_USER_AGENT=AAIRE/1.0 (your-email@company.com)
# FRED_API_KEY=your_fred_api_key_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# File Upload Settings
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIRECTORY=data/uploads

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Production Settings
# ALLOWED_ORIGINS=https://yourdomain.com
# DOMAIN=yourdomain.com
# SSL_ENABLED=true
# SECURE_COOKIES=true

# AWS S3 (optional — for document storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=aaire-documents

# Google Cloud (optional — for OCR fallback)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
